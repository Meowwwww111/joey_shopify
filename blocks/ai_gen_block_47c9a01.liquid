{% doc %}
  Back to top button
{% enddoc %}

<style>
  #my-back-to-top {
    position: fixed;
    right: 25px;
    bottom: 25px;
    width: 56px;
    height: 56px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #3C0106;
    border: none;
    border-radius: 50%;

    z-index: 999999;
    cursor: pointer;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
      opacity 0.25s ease,
      visibility 0.25s ease,
      transform 0.2s ease;
  }

  #my-back-to-top.show {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  #my-back-to-top:hover {
    transform: translateY(-3px);
    background: #5A0710;
  }

  #my-back-to-top svg {
    width: 28px;
    height: 28px;
    fill: #ffffff;
  }

  @media screen and (max-width: 749px) {
    #my-back-to-top {
      width: 52px;
      height: 52px;
      right: 16px;
      bottom: 16px;
    }
  }
</style>

<button
  id="my-back-to-top"
  type="button"
  aria-label="Back to top"
>
  <svg
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path d="M12 4L3 13h5v7h8v-7h5L12 4z"></path>
  </svg>
</button>

<script>
(function() {

  var button = document.getElementById('my-back-to-top');
  var scrollContainer = document.querySelector('.page-wrapper');

  if (!button) {
    console.log('BACK TO TOP: button not found');
    return;
  }

  if (!scrollContainer) {
    console.log('BACK TO TOP: .page-wrapper not found');
    return;
  }

  console.log('BACK TO TOP: initialized');
  console.log('BACK TO TOP: scroll container found');
  console.log('BACK TO TOP: current scrollTop =', scrollContainer.scrollTop);

  function updateButton() {

    var scrollTop = scrollContainer.scrollTop;

    console.log('BACK TO TOP: scrollTop =', scrollTop);

    if (scrollTop > 300) {
      button.classList.add('show');
    } else {
      button.classList.remove('show');
    }
  }

  scrollContainer.addEventListener('scroll', updateButton);

  button.addEventListener('click', function() {

    console.log('BACK TO TOP: CLICKED');
    console.log(
      'BACK TO TOP: scrolling from',
      scrollContainer.scrollTop,
      'to 0'
    );

    scrollContainer.scrollTo({
      top: 0,
      left: 0,
      behavior: 'smooth'
    });

  });

  updateButton();

})();
</script>

{% schema %}
{
  "name": "Back to top button",
  "settings": [],
  "presets": [
    {
      "name": "Back to top button"
    }
  ]
}
{% endschema %}